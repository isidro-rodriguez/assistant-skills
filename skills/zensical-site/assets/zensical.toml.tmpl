# zensical.toml
# Configuración de la documentación de ${name} (Zensical).
# Estructura común gestionada por la skill `zensical-site`.
# Referencia: https://zensical.org/docs/setup/basics/
#
#   uv run zensical serve   # vista previa en http://localhost:8000 con recarga
#   uv run zensical build   # genera el sitio estático en site/

[project]
site_name = "${name}"
site_description = "${description}"
site_author = "${author}"
# GitHub Pages distingue mayúsculas en la ruta: debe coincidir con el nombre del repo.
site_url = "${site_url}"
repo_url = "${repo_url}"
repo_name = "${repo_name}"
edit_uri = "edit/main/docs/"
copyright = "Copyright &copy; ${year} ${author}"
docs_dir = "docs"
site_dir = "site"
# typography.css (común) primero; ${slug}.css (propio del proyecto) la puede pisar.
extra_css = ["assets/stylesheets/typography.css", "assets/stylesheets/${slug}.css"]

nav = [
    { "Inicio" = "index.md" },
]

[project.theme]
language = "es"
# Plantillas propias: favicons y manifiesto web (`docs_templates/main.html`).
custom_dir = "docs_templates"
favicon = "assets/favicon/favicon-32x32.png"
logo = "assets/images/${logo}"
# Fuentes servidas desde el sitio (assets/fonts, typography.css), sin Google Fonts.
font = false
features = [
    "content.action.edit",
    "content.code.annotate",
    "content.code.copy",
    "content.code.select",
    "content.footnote.tooltips",
    "content.tabs.link",
    "content.tooltips",
    "navigation.footer",
    "navigation.indexes",
    "navigation.instant",
    "navigation.instant.prefetch",
    "navigation.path",
    "navigation.sections",
    "navigation.top",
    "navigation.tracking",
    "search.highlight",
    "toc.follow",
]

# Los colores están en `docs/assets/stylesheets/${slug}.css`.
[[project.theme.palette]]
media = "(prefers-color-scheme)"
primary = "custom"
accent = "custom"
toggle.icon = "lucide/sun-moon"
toggle.name = "Cambiar a modo claro"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
primary = "custom"
accent = "custom"
toggle.icon = "lucide/sun"
toggle.name = "Cambiar a modo oscuro"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
primary = "custom"
accent = "custom"
toggle.icon = "lucide/moon"
toggle.name = "Cambiar a la preferencia del sistema"

[project.extra]
# Color de la barra del navegador (docs_templates/main.html) y del manifiesto.
theme_color = "${theme_color}"

[[project.extra.social]]
icon = "fontawesome/brands/github"
link = "${repo_url}"
name = "Código fuente en GitHub"

[project.markdown_extensions]
abbr = {}
admonition = {}
attr_list = {}
def_list = {}
footnotes = {}
md_in_html = {}
toc.permalink = true
# Anclajes con tildes, igual que GitHub: los enlaces `#validación` funcionan en
# la web y al leer los .md en el repositorio.
toc.slugify = { object = "pymdownx.slugs.slugify", kwds = { case = "lower" } }
pymdownx.betterem = {}
pymdownx.caret = {}
pymdownx.details = {}
pymdownx.emoji.emoji_generator = "zensical.extensions.emoji.to_svg"
pymdownx.emoji.emoji_index = "zensical.extensions.emoji.twemoji"
pymdownx.highlight.anchor_linenums = true
pymdownx.highlight.line_spans = "__span"
pymdownx.highlight.pygments_lang_class = true
pymdownx.inlinehilite = {}
pymdownx.keys = {}
pymdownx.magiclink = {}
pymdownx.mark = {}
pymdownx.smartsymbols = {}
pymdownx.superfences.custom_fences = [
    { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
]
pymdownx.tabbed.alternate_style = true
pymdownx.tabbed.combine_header_slug = true
pymdownx.tasklist.custom_checkbox = true
pymdownx.tilde = {}
