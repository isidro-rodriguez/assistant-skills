
# Referencia de la API generada desde los docstrings.
# Requiere `mkdocstrings-python` (grupo de desarrollo); api-autonav lo implementa Zensical.
[project.plugins.api-autonav]
modules = ["src/${package}"]
api_root_uri = "api"
nav_section_title = "API"

[project.plugins.mkdocstrings]
locale = "es"
# Traducción al español de las plantillas de mkdocstrings.
custom_templates = "docs_templates"

[project.plugins.mkdocstrings.handlers.python]
paths = ["src"]

[project.plugins.mkdocstrings.handlers.python.options]
docstring_style = "google"
members_order = "source"
merge_init_into_class = true
separate_signature = true
show_signature_annotations = true
show_source = true
